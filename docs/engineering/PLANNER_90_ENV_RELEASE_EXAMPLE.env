# Increment 61 — reviewed local test environment only. Do not commit secrets.
# Source package requires laravel/mcp:^1.2. Existing composer.lock intentionally preserved.
PLANNER_INTEGRATION_READ_ENABLED=false
PLANNER_MCP_READ_ENABLED=false
# Optional exact origins (not wildcard, no trailing slash), for browser MCP clients:
PLANNER_MCP_ALLOWED_ORIGINS=
PLANNER_OPERATIONAL_ALERT_SCAN_ENABLED=false
# Existing provider release flags remain disabled. Never enable for local unverified environments.
PLANNER_TEXT_DISPATCH_ENABLED=false
PLANNER_MEDIA_WORKER_ENABLED=false
PLANNER_YOUTUBE_RESUMABLE_ENABLED=false
