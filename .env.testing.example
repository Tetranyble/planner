# Copy to .env.testing, then generate a new testing APP_KEY.
# DANGER: running tests invokes RefreshDatabase, which drops/recreates tables.
APP_NAME=PlannerTesting
APP_ENV=testing
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=planner_test
DB_USERNAME=planner_test
DB_PASSWORD=replace_with_disposable_local_test_password
DB_URL=
UNIPOTENCE_DB_CONNECTION=mysql

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
NIGHTWATCH_ENABLED=false

PLANNER_CREATIVE_IMAGE_ENABLED=false
PLANNER_CREATIVE_AUTO_STORAGE_ENABLED=false
PLANNER_PUBLISHING_ENABLED=false
PLANNER_YOUTUBE_RESUMABLE_ENABLED=false
