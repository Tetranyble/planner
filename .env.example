# Local or CI only. NEVER copy this file to production unchanged.
APP_NAME=Planner
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
INERTIA_USE_SCRIPT_ELEMENT_FOR_INITIAL_PAGE=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=planner_local
DB_USERNAME=planner_local
DB_PASSWORD=
DB_URL=
UNIPOTENCE_DB_CONNECTION=mysql
QUEUE_CONNECTION=database
SESSION_DRIVER=database
CACHE_STORE=database
MAIL_MAILER=log
FILESYSTEM_DISK=local
TELESCOPE_ENABLED=false
# No real provider credentials should be committed here.
META_APP_ID=
META_APP_SECRET=
META_ACTOR_HMAC_KEY=
SOCIAL_GRANT_ACTOR_HMAC_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PLANNER_AI_API_KEY=
PLANNER_INTEGRATION_READ_ENABLED=false
PLANNER_MCP_READ_ENABLED=false
PLANNER_OPERATIONAL_ALERT_SCAN_ENABLED=false
PLANNER_OPERATIONAL_ALERT_MAIL_ENABLED=false
PLANNER_EMERGENCY_PUBLISH_STOP=true
PLANNER_TEXT_DISPATCH_ENABLED=false
PLANNER_TEXT_DISPATCH_PROVIDER_APPROVED=false
PLANNER_TEXT_DISPATCH_RELEASED=false
PLANNER_MEDIA_WORKER_ENABLED=false
PLANNER_MEDIA_DISPATCH_RELEASED=false
PLANNER_YOUTUBE_RESUMABLE_ENABLED=false
PLANNER_STORAGE_V3_ADAPTER_VERIFIED=false
PLANNER_MEDIA_DELIVERY_ORIGIN_VERIFIED=false
PLANNER_PROVIDER_METRIC_SYNC_ENABLED=false
PLANNER_PROVIDER_METRIC_AUTOQUEUE_ENABLED=false
PLANNER_X_METRIC_SYNC_ENABLED=false
PLANNER_FACEBOOK_METRIC_SYNC_ENABLED=false
PLANNER_TIKTOK_METRIC_SYNC_ENABLED=false
PLANNER_INSTAGRAM_METRIC_SYNC_ENABLED=false
PLANNER_REPORT_SCHEDULER_ENABLED=false
SOCIAL_REMOTE_REVOCATION_ENABLED=false

# Agent orchestration: separate from read-only MCP and from live provider switches.
PLANNER_AGENT_ACCESS_ENABLED=false
PLANNER_AGENT_WRITE_ENABLED=false
PLANNER_AGENT_AUTONOMY_ENABLED=false
PLANNER_AI_RESEARCH_MODEL=gpt-6-astra
PLANNER_AGENT_DELEGATED_PUBLISHING_ENABLED=false
PLANNER_AGENT_ALLOWED_ORIGINS=

# Native ChatGPT OAuth connection (requires Passport and existing owner-issued agent delegation).
# Keep disabled until database, HTTPS, PKCE, client registration, and consent are verified.
PLANNER_OAUTH_ENABLED=false
PLANNER_OAUTH_DCR_ENABLED=false
PLANNER_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com

# Private on-demand image previews, OFF until verified (no server-side media import)
PLANNER_CREATIVE_IMAGE_ENABLED=false
PLANNER_CREATIVE_HANDOFF_TTL_MINUTES=60
PLANNER_AI_IMAGE_MODEL=gpt-image-2.5-flare

# Requires real Tetranyble Storage v3 upload/scan/ACL staging verification; no automatic media approval.
PLANNER_CREATIVE_AUTO_STORAGE_ENABLED=false

PLANNER_RECURRING_EXPANSION_ENABLED=false
